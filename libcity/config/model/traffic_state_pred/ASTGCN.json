{
  "nb_block": 2,
  "K": 3,
  "nb_chev_filter": 64,
  "nb_time_filter": 64,

  "scaler": "standard",
  "load_external": true,
  "normal_external": false,
  "ext_scaler": "none",
  "add_time_in_day": true,
  "add_day_in_week": true,
  "train_rate": 0.6,
  "eval_rate": 0.2,

  "input_window": 24,
  "output_window": 24,
  
  "max_epoch": 100,
  "learner": "adam",
  "learning_rate": 1e-3,
  "lr_decay": false,
  "clip_grad_norm": true,
  "max_grad_norm":5,
  "use_early_stop": true,
  "patience":15
}
