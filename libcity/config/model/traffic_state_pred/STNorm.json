{
    "max_epoch": 100,

    "learner": "adam",
    "learning_rate": 1e-3,


    "scaler": "standard",
    "load_external": true,
    "normal_external": false,
    "ext_scaler": "none",
    "add_time_in_day": true,
    "add_day_in_week": true,
    "lr_decay": false,
    "lr_scheduler": "steplr",
    "step_size": 50,
    "lr_decay_ratio": 0.5,

    "clip_grad_norm": true,
    "max_grad_norm": 5,
    "use_early_stop": true,
    "patience": 15,

    "blocks": 1,
    "layers": 4,
    "kernel_size": 2,
    "snorm_bool": true,
    "tnorm_bool": true,
    "hidden_channels": 16,
    "n_pred": 3
  }