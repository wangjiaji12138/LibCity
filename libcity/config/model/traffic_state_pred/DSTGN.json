{
  "max_epoch": 100,
  "learner": "adam",
  "learning_rate": 1e-3,
  "lr_epsilon": 1e-8,
  "weight_decay": 0.0001,

  "lr_decay": true,
  "lr_scheduler": "multisteplr",
  "lr_decay_ratio": 0.5,
  "steps": [20, 30, 50, 70, 90],

  "use_early_stop": true,
  "patience": 15,

  "steps_per_day": 48,
  "input_embedding_dim": 48,
  "spatial_embedding_dim": 48,
  "feed_forward_dim": 256,
  "num_heads": 4,
  "num_layers": 3,
  "dropout": 0.1,
  "use_mixed_proj": true
}
