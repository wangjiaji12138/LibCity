{
  "max_epoch": 100,
  "learner": "adam",
  "learning_rate": 1e-3,
  "lr_epsilon": 1e-8,
  "weight_decay": 1e-4,

  "lr_decay": true,
  "lr_scheduler": "multisteplr",
  "lr_decay_ratio": 0.5,
  "steps": [20, 30, 50, 70, 90],

  "input_window": 24,
  "output_window": 24,
  "steps_per_day": 48,
  "train_rate": 0.6,
  "eval_rate": 0.2,

  "scaler": "standard",
  "load_external": true,
  "normal_external": false,
  "ext_scaler": "none",
  "add_time_in_day": true,
  "add_day_in_week": true,

  "batch_size": 64,
  "input_embedding_dim": 32,
  "spatial_embedding_dim": 32,
  "tod_embedding_dim": 16,
  "dow_embedding_dim": 16,
  "feed_forward_dim": 256,
  "num_heads": 4,
  "num_layers": 3,
  "gcn_depth": 2,
  "dropout": 0.1,
  "use_early_stop": true,
  "patience": 15,

  "num_prototypes": 16,
  "prototype_dim": 128,
  "prototype_temperature": 0.3,
  "contrastive_loss_weight": 0.1,
  "contrastive_temperature": 0.1,
  "geo_smooth_weight": 0.1
}
