{
  "hidden_dim": 64,
  "num_layers": 2,
  "num_heads": 4,
  "dropout": 0.1,

  "scaler": "standard",
  "load_external": true,
  "normal_external": false,
  "ext_scaler": "none",
  "add_time_in_day": true,
  "add_day_in_week": true,

  "max_epoch": 100,
  "learner": "adam",
  "learning_rate": 1e-3,
  "lr_decay": true,
  "lr_scheduler": "steplr",
  "lr_decay_ratio": 0.5,
  "step_size": 20,
  "clip_grad_norm": true,
  "max_grad_norm": 5,
  "use_early_stop": true,
  "patience": 15
}
